{
  "name": "RoleSync Studio Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {},
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "RoleSync Web Studio",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "streamlit run web_app.py --server.port 8501 --server.address 0.0.0.0"
}
